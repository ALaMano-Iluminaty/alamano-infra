# Copia a .env en cada VM. Las secciones que no apliquen a esa VM se ignoran.

# ── Comun ─────────────────────────────────────────────────────────────────────
DOMAIN=alamano.<zona>.cloudapp.azure.com
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=<generar>
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=<generar>
CORE_DB_USER=core_app
CORE_DB_PASSWORD=<generar>
RABBITMQ_USER=alamano
RABBITMQ_PASSWORD=<generar>

# ── VM entrada ────────────────────────────────────────────────────────────────
# IPs privadas de vm-app-1 y vm-app-2 (mirar scripts/provision-azure.sh)
AUTH_UPSTREAMS=10.0.1.5:8081 10.0.1.6:8081
CORE_UPSTREAMS=10.0.1.5:8082 10.0.1.6:8082
GATEWAY_UPSTREAMS=10.0.1.5:8083 10.0.1.6:8083
FRONTEND_UPSTREAM=10.0.1.5:80
GRAFANA_ADMIN_PASSWORD=<generar>

# ── VM app (1 y 2) ────────────────────────────────────────────────────────────
HOSTNAME=app-1
DB_HOST=10.0.1.7
REDIS_HOST=10.0.1.7
RABBIT_HOST=10.0.1.7
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=
ALLOWED_ORIGINS=https://alamano.<zona>.cloudapp.azure.com
