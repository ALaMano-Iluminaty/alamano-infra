# Copia a .env (NUNCA se sube a git).
# Estos valores sirven en local. En la VM cambia TODAS las contrasenas:
#   openssl rand -base64 18

# Puerto de Postgres en tu PC. Si ya tienes otro Postgres en el 5432, usa 5433.
POSTGRES_PORT=5433

# Puerto de nginx en local. En la VM no se usa: entra Caddy por 80 y 443.
NGINX_PORT=8080

# Solo VM: el nombre DNS, por ejemplo alamano.eastus.cloudapp.azure.com
DOMAIN=localhost

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=auth_app
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_app

RABBITMQ_USER=alamano
RABBITMQ_PASSWORD=alamano
