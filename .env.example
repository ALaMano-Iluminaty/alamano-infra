# Copia a .env (NUNCA se sube a git).
# Estos valores sirven en local. En la VM cambia TODAS las contrasenas:
#   openssl rand -base64 18

# Puerto de Postgres en tu PC. Si ya tienes otro Postgres en el 5432, usa 5433.
POSTGRES_PORT=5433

# Puerto de nginx en local. En la VM no se usa: entra Caddy por 80 y 443.
NGINX_PORT=8080

# Solo VM: el nombre DNS, por ejemplo alamano.eastus.cloudapp.azure.com
DOMAIN=localhost

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=auth_app
CORE_DB_USER=core_app
CORE_DB_PASSWORD=core_app

RABBITMQ_USER=alamano
RABBITMQ_PASSWORD=alamano

# Google Sign-In (HU-G2). Cuando esta vacio, /auth/google responde 401 (no se
# admite ningun id_token). Pegar aqui el Client ID de "ALaMano" en Google Cloud.
GOOGLE_CLIENT_ID=

# HU-Q3: correos (separados por coma) que entran como ADMIN al iniciar sesion con
# Google. Es el primer administrador; los demas roles los cambia un ADMIN desde la app.
ADMIN_EMAILS=

# Grafana (HU-Q10): cambiar en la VM antes de levantar.
GRAFANA_ADMIN_PASSWORD=admin

# Upstreams para Caddy en modo HA (docker-compose.ha.yml). Si no se definen,
# Caddy reparte entre los nombres de servicio por defecto.
# CORE_UPSTREAMS=core-service:8082 core-service-2:8082
# GATEWAY_UPSTREAMS=realtime-gateway:8083 realtime-gateway-2:8083
