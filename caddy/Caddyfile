# Caddy pide y renueva el certificado de Let's Encrypt solo.
# El WebSocket (wss://) pasa sin configuracion extra.
{
	# El plugin de rate limit no es estandar: hay que decirle a Caddy en que orden va.
	order rate_limit before reverse_proxy
}

{$DOMAIN} {
	# HU-Q4: 100 peticiones por minuto por IP en /auth y /api, con 429. nginx aplica la
	# misma regla detras; aqui se corta antes de que el exceso entre a la red interna.
	@api path /auth/* /api/*
	rate_limit @api {
		zone borde {
			key {remote_host}
			events 100
			window 1m
		}
		log_key
	}

	# Tablero de Grafana (docker-compose.observabilidad.yml). Si no esta levantado, 502 solo aqui.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy nginx:80
	}
}
